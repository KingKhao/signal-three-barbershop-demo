  "narrative": {
    "dos": [
      "**Do** preserve the charcoal, cream and chartreuse hierarchy.",
      "**Do** keep queue rows readable and primary actions ahead of imagery on phones.",
      "**Do** use ticket material and inline SVG icons where those patterns recur.",
      "**Do** keep fictional-demo labels and visible focus states alongside interactions."
    ],
    "keyCharacteristics": [
      "Monumental condensed type and tabular queue numerals.",
      "Flat, square surfaces with strong tonal separation.",
      "Physical ticket details and quick, controllable motion."
    ],
    "overview": "The implemented world is direct, compact and mechanical: broad condensed lettering, numbered chair rows, rectangular photographs and paper tickets. Charcoal and cream establish the material; chartreuse marks action and readiness. This code-first record captures the finished implementation, not a pre-build approval.\n\nQuick state changes support queue and booking previews. Content stays visible before entrance effects run. The fictional identity deliberately differs from Sunday House's soft salon direction.",
    "northStar": "The Three-Chair Dispatch Board",
    "donts": [
      "**Don't** introduce soft salon arches, serif display type or ornamental barber clipart.",
      "**Don't** replace raster product photography with CSS object stand-ins.",
      "**Don't** hide necessary content behind slow motion or freeze task dialogues when decoration is paused."
    ],
    "rules": [
      {
        "body": "Use chartreuse for actions and meaningful active states; preserve clear dark text on chartreuse.",
        "section": "colors",
        "name": "The Readiness Rule"
      },
      {
        "body": "Keep condensed type for identity, headings and numerals; use the body face for instructions and form controls.",
        "section": "typography",
        "name": "The Two-Voice Rule"
      }
    ]
  },
